{
  "name": "vibe-coding-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- turbo run dev",
    "build": "dotenv -e .env.local -- turbo run build",
    "start": "dotenv -e .env.local -- turbo run start",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt apps/**/*.{ts,tsx,js,jsx,json,css,md}",
    "test": "pnpm --filter @vibe-coding/web test",
    "test:coverage": "pnpm --filter @vibe-coding/web test:coverage",
    "test:e2e": "pnpm --filter @vibe-coding/web test:e2e",
    "test:a11y": "pnpm --filter @vibe-coding/web test:a11y",
    "test:visual": "pnpm --filter @vibe-coding/web test:visual"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.66.0",
    "turbo": "^2.5.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
