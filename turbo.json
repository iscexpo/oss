{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PHASE",
    "KILO_API_KEY",
    "KILO_GATEWAY_BASE_URL",
    "AI_GATEWAY_API_KEY",
    "VIBE_PREVIEW_PROXY_URL",
    "VIBE_CLONE_ORIGIN",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_RELATED_PROJECTS",
    "V0_RUNTIME_URL",
    "V0_BUILD_URL",
    "V0_SANDBOX_URL",
    "V0_CALLBACK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {}
  }
}