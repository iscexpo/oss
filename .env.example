# AI Gateway (Kilo)
KILO_API_KEY=
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway

# Preview proxy origin resolution
#   - local:     defaults to http://localhost:3001
#   - production: set this to the deployed sandbox-proxy origin
VIBE_PREVIEW_PROXY_URL=

# Allowed origin for the sandbox-proxy (the web app origin). Used by the
# proxy to authorize preview and API requests. Falls back to
# VERCEL_RELATED_PROJECTS in preview/production on Vercel.
VIBE_CLONE_ORIGIN=